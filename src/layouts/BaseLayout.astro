---
import '../styles/global.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description || ''} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      (() => {
        const savedMode = localStorage.getItem('theme-mode') || 'auto';
        const resolveTheme = (mode) => {
          if (mode !== 'auto') return mode;
          const now = new Date();
          const hour = now.getHours();
          const isNight = hour < 6 || hour >= 20;
          return isNight ? 'dark' : 'light';
        };
        const resolvedTheme = resolveTheme(savedMode);
        document.documentElement.setAttribute('data-theme-mode', savedMode);
        document.documentElement.setAttribute('data-theme', resolvedTheme);
      })();
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <a href={base} class="logo">Phil Ball</a>
        <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="menu-icon" aria-hidden="true">☰</span>
          <span>Menu</span>
        </button>
        <ul class="nav-links" id="primary-navigation">
          <li><a href={`${base}blog/`}>Writing</a></li>
          <li><a href={`${base}projects/`}>Projects</a></li>
          <li><a href={`${base}publications/`}>Publications</a></li>
          <li><a href={`${base}cv/`}>CV</a></li>
          <li><a href={`${base}leadership/`}>Leadership</a></li>
          <li><a href={`${base}evidence-map/`}>Evidence Map</a></li>
          <li><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Theme: automatic, follows local time" title="Theme: automatic, follows local time">◐</button></li>
        </ul>
      </div>
    </nav>

    <main><slot /></main>

    <footer class="footer"><div class="footer-container"><div><strong>Phil Ball, PhD</strong><p>Personal professional site · Views and analysis are my own. Policy analysis uses publicly available sources and does not represent government policy, official advice or my employer.</p></div><div class="footer-links"><a href="https://www.linkedin.com/in/philipbball/" target="_blank" rel="noreferrer">LinkedIn</a><a href="https://independent.academia.edu/BallPhilip" target="_blank" rel="noreferrer">Academia</a><a href="https://ideas.repec.org/f/pba802.html" target="_blank" rel="noreferrer">RePEc</a></div></div></footer>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const navigation = document.getElementById('primary-navigation');
      const themeToggle = document.getElementById('theme-toggle');
      const html = document.documentElement;

      if (menuToggle && navigation) {
        menuToggle.addEventListener('click', () => {
          const isOpen = navigation.classList.toggle('is-open');
          menuToggle.setAttribute('aria-expanded', String(isOpen));
          const icon = menuToggle.querySelector('.menu-icon');
          if (icon) icon.textContent = isOpen ? '×' : '☰';
        });

        navigation.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            navigation.classList.remove('is-open');
            menuToggle.setAttribute('aria-expanded', 'false');
            const icon = menuToggle.querySelector('.menu-icon');
            if (icon) icon.textContent = '☰';
          });
        });
      }

      const getFallbackTheme = (mode) => {
        if (mode !== 'auto') return mode;
        const now = new Date();
        const hour = now.getHours();
        const isNight = hour < 6 || hour >= 20;
        return isNight ? 'dark' : 'light';
      };

      const resolveTheme = (mode) => {
        if (mode !== 'auto') return mode;
        return getFallbackTheme(mode);
      };

      const updateThemeControl = () => {
        if (!themeToggle) return;
        const mode = html.getAttribute('data-theme-mode') || 'auto';
        const theme = html.getAttribute('data-theme') || getFallbackTheme(mode);
        if (mode === 'auto') {
          themeToggle.textContent = '◐';
          themeToggle.setAttribute('aria-label', `Theme: automatic, currently ${theme} based on local daylight. Click for light mode`);
          themeToggle.setAttribute('title', `Theme: automatic · currently ${theme} (daylight)`);
        } else if (mode === 'light') {
          themeToggle.textContent = '☀️';
          themeToggle.setAttribute('aria-label', 'Theme: light. Click for dark mode');
          themeToggle.setAttribute('title', 'Theme: light');
        } else {
          themeToggle.textContent = '🌙';
          themeToggle.setAttribute('aria-label', 'Theme: dark. Click to return to automatic mode');
          themeToggle.setAttribute('title', 'Theme: dark');
        }
      };

      const setMode = (mode) => {
        html.setAttribute('data-theme-mode', mode);
        html.setAttribute('data-theme', getFallbackTheme(mode));
        localStorage.setItem('theme-mode', mode);
        updateThemeControl();
      };

      const refreshAutoTheme = () => {
        if ((html.getAttribute('data-theme-mode') || 'auto') === 'auto') {
          const theme = resolveTheme('auto');
          html.setAttribute('data-theme', theme);
          updateThemeControl();
        }
      };

      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) refreshAutoTheme();
      });

      window.setInterval(refreshAutoTheme, 60000);

      if (themeToggle) {
        updateThemeControl();
        themeToggle.addEventListener('click', () => {
          const mode = html.getAttribute('data-theme-mode') || 'auto';
          const nextMode = mode === 'auto' ? 'light' : mode === 'light' ? 'dark' : 'auto';
          setMode(nextMode);
        });
      }
    </script>
  </body>
</html>
