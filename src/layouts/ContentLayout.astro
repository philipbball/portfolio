---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
}

const content = Astro.props.frontmatter ?? Astro.props;
const { title, description, date, author } = content;
const parsedDate = date ? new Date(date) : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="content-article">
    <header class="article-header">
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}
      <div class="article-meta">
        {parsedDate && <time datetime={parsedDate.toISOString()}>{parsedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
        {author && <span class="author">by {author}</span>}
      </div>
    </header>
    <div class="article-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .content-article {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) 0;
  }

  .article-header {
    max-width: 980px;
    margin: 0 0 clamp(2rem, 5vw, 3.5rem);
  }

  .article-header h1 {
    max-width: 18ch;
    font-size: clamp(2.7rem, 7vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin: 0 0 1rem;
  }

  .description {
    max-width: 760px;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  .article-content {
    max-width: 980px;
    line-height: 1.78;
    font-size: 1.03rem;
  }

  .article-content :global(h2) {
    margin-top: 2.8rem;
    margin-bottom: 1rem;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    letter-spacing: -0.025em;
  }

  .article-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .article-content :global(p),
  .article-content :global(ul),
  .article-content :global(ol),
  .article-content :global(blockquote) {
    max-width: 82ch;
  }

  .article-content :global(p) {
    margin-bottom: 1.15rem;
  }

  .article-content :global(code) {
    background: var(--bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
  }

  .article-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.2rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.55rem;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 0.2rem 0 0.2rem 1.1rem;
    margin: 1.6rem 0;
    color: var(--text-secondary);
    font-size: 1.08rem;
    font-style: italic;
  }

  .article-content :global(table) {
    display: table;
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.92rem;
  }

  .article-content :global(th),
  .article-content :global(td) {
    min-width: 9rem;
    padding: 0.8rem;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--border);
  }

  .article-content :global(th) {
    background: var(--bg-secondary);
    font-weight: 700;
  }

  .article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 3rem 0 1.5rem;
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .article-content :global(a:hover) {
    text-decoration: underline;
  }

  .article-content :global(details) {
    width: 100%;
    margin: 1.15rem 0;
    padding: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .article-content :global(details > summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 0.95rem 1.1rem;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .article-content :global(details > summary::-webkit-details-marker) {
    display: none;
  }

  .article-content :global(details > summary::after) {
    content: '+';
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  .article-content :global(details[open] > summary::after) {
    content: '−';
  }

  .article-content :global(details > :not(summary)) {
    margin-left: 1.1rem;
    margin-right: 1.1rem;
  }

  .article-content :global(details > h2:first-of-type),
  .article-content :global(details > h3:first-of-type) {
    margin-top: 0.9rem;
  }

  @media (max-width: 760px) {
    .content-article {
      width: min(100% - 2rem, 1200px);
      padding: 2rem 0;
    }

    .article-header h1 {
      max-width: none;
      font-size: clamp(2.3rem, 12vw, 3.6rem);
      overflow-wrap: anywhere;
    }

    .article-content {
      font-size: 1rem;
      line-height: 1.7;
    }

    .article-content :global(table) {
      display: block;
      overflow-x: auto;
    }

    .article-content :global(blockquote) {
      margin-left: 0;
      margin-right: 0;
      padding-left: 0.85rem;
    }
  }
</style>
