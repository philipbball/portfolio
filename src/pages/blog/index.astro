---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const linkedInGroups = [
  { title:'AI, productivity and economic change', description:'Posts on the gap between task-level AI gains and realised productivity, and what that implies for organisations and economic policy.', posts:[
    {title:'AI productivity and organisational design',description:'Why faster task completion does not automatically translate into higher system-level productivity—and why organisational design, coordination and review matter.',url:'https://www.linkedin.com/posts/philipbball_ai-productivity-futureofwork-share-7441537202976804864-wkfS/'},
    {title:'AI productivity: reading the emerging economic evidence',description:'Reflections on the evidence base for AI productivity gains, including what aggregate estimates can and cannot tell us about realised economic value.',url:'https://www.linkedin.com/posts/philipbball_ai-productivity-economics-share-7446925771790737408-764V/'},
    {title:'AI productivity and economic policy',description:'What uneven adoption, complementary investment and institutional capability mean for translating AI diffusion into broader economic gains.',url:'https://www.linkedin.com/posts/philipbball_ai-productivity-economicpolicy-activity-7437107149161324544-t1B4'}]},
  { title:'Responsible AI, institutions and public services', description:'Posts about the institutional conditions around AI: capacity, governance, accountability, literacy and the gap between national ambition and delivery contexts.', posts:[
    {title:'The AI devolution fault line',description:'A visual exploration of the gap between national AI ambition and local public-service delivery, and why capability, governance and implementation conditions matter.',url:'https://www.linkedin.com/posts/philipbball_the-ai-devolution-fault-line-ugcPost-7485235169386401792-FeuO/',label:'Visual essay'},
    {title:'AI detection, critical AI literacy and academic integrity',description:'Why responsible adoption in education needs more than detection: critical literacy, transparent rules and assessment design remain central.',url:'https://www.linkedin.com/posts/philipbball_aidetection-criticalailiteracy-academicintegrity-share-7487310113775546368-HK8S/'}]},
  { title:'Public value, fairness and opportunity', description:'Writing about who gets access to valued institutions and opportunities—and why distribution, social infrastructure and fairness are part of public value.', posts:[{title:'Who gets to swim?',description:'A public-value lens on access, social infrastructure and the distribution of opportunity.',url:'https://www.linkedin.com/posts/philipbball_whogetstoswim-publicvalue-socialinfrastructure-activity-7485975960576565248-yYee'}]}
];
const adjacentPosts=[{title:'Climate risk, climate finance and insurance',description:'An adjacent strand connecting resilience, risk allocation, finance and sustainability.',url:'https://www.linkedin.com/posts/philipbball_climaterisk-climatefinance-insurance-activity-7471700045789204480-X9eu'}];
const authoredPosts=[{title:"The UK’s productivity puzzle and its implications for government policy",date:'14 July 2017',description:'A firm-level account of weak UK productivity and the implications for capital allocation, competition, innovation and public policy.',url:'https://economicsforthemillion.wordpress.com/2017/07/14/the-uks-productivity-puzzle-and-its-implications-for-government-policy/'}];
---
<BaseLayout title="Writing — Phil Ball" description="Essays, analytical writing and selected LinkedIn posts by Phil Ball"><div class="listing-page">
<header class="page-header"><span class="eyebrow">Writing</span><h1>Evidence, institutions and public value.</h1><p class="intro">Longer-form essays, analytical projects and selected public posts. The emphasis is on evidence, implementation, economic change, fairness and the institutions that turn ideas into realised value.</p></header>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">Featured essays</span><h2>Longer-form writing</h2></div></div><div class="feature-grid"><article class="feature-card"><small>2026 · Evidence and implementation</small><h3><a href={`${base}projects/when-targeting-need-is-not-enough/`}>When targeting need is not enough</a></h3><p>How need, prevention, local capacity, additionality and marginal value can inform allocation and active stewardship without weakening the equity objective.</p><a class="read-link" href={`${base}projects/when-targeting-need-is-not-enough/`}>Read the evidence project →</a></article><article class="feature-card personal"><small>Personal essay · Black History Month</small><h3><a href={`${base}blog/reclaiming-my-dual-heritage-narrative/`}>Reclaiming my dual heritage narrative</a></h3><p>A personal reflection on identity, family, resilience, fairness and what I inherited from two very different but complementary traditions of education and service.</p><a class="read-link" href={`${base}blog/reclaiming-my-dual-heritage-narrative/`}>Read the essay →</a></article></div></section>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">Selected LinkedIn writing</span><h2>Shorter public posts, grouped by theme</h2><p>LinkedIn remains the original publication location for these posts; this page provides a stable thematic index rather than reproducing the feed.</p></div></div>{linkedInGroups.map(group=><div class="topic-group"><div class="topic-intro"><h3>{group.title}</h3><p>{group.description}</p></div><div class="post-grid">{group.posts.map(post=><article class="post-card"><small>{post.label||'LinkedIn'}</small><h4><a href={post.url} target="_blank" rel="noreferrer">{post.title} ↗</a></h4><p>{post.description}</p></article>)}</div></div>)}</section>
<section class="section-block adjacent"><div class="section-heading"><div><span class="eyebrow">Connected strand</span><h2>Climate, resilience and sustainable finance</h2><p>Related to the core portfolio through risk, resilience and public value, but kept distinct from the main AI/institutions thread.</p></div></div><div class="post-grid">{adjacentPosts.map(post=><article class="post-card"><small>LinkedIn · Adjacent</small><h4><a href={post.url} target="_blank" rel="noreferrer">{post.title} ↗</a></h4><p>{post.description}</p></article>)}</div></section>
<section class="section-block archive-section"><div class="section-heading"><div><span class="eyebrow">Earlier writing</span><h2>Selected Economics for the Million archive</h2><p>Selected original writing that remains relevant to the themes of the current portfolio. The complete historical archive remains available separately.</p></div></div>{authoredPosts.map(post=><article class="archive-item"><small>{post.date}</small><h3><a href={post.url} target="_blank" rel="noreferrer">{post.title} ↗</a></h3><p>{post.description}</p></article>)}<a class="archive-link" href="https://economicsforthemillion.wordpress.com/" target="_blank" rel="noreferrer">Visit the complete historical archive ↗</a></section>
</div></BaseLayout>
<style>.listing-page{width:min(var(--site-width),calc(100% - 2rem));margin:0 auto;padding:clamp(2.5rem,7vw,5rem) 0}.eyebrow,small{text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-size:.74rem;font-weight:800}.page-header{max-width:950px}.page-header h1{font-size:clamp(3rem,7vw,5.8rem);line-height:.95;letter-spacing:-.055em;margin:.55rem 0 1.25rem}.intro{font-size:clamp(1.05rem,2vw,1.2rem);line-height:1.7;color:var(--text-secondary);max-width:780px}.section-block{padding:clamp(3rem,6vw,5rem) 0;border-top:1px solid var(--border)}.section-heading{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:2rem;align-items:end;margin-bottom:1.5rem}.section-heading h2{font-size:clamp(2rem,4vw,3.4rem);letter-spacing:-.04em;margin:.35rem 0}.section-heading p,.topic-intro p{color:var(--text-secondary);line-height:1.65}.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.feature-card,.post-card{border:1px solid var(--border);border-radius:18px;background:var(--bg-secondary)}.feature-card{padding:1.55rem}.feature-card.personal{border-top:4px solid var(--accent)}.feature-card h3{font-size:1.65rem;margin:.4rem 0 .75rem}.feature-card h3 a,.post-card a,.archive-item a,.read-link,.archive-link{text-decoration:none}.feature-card h3 a:hover,.post-card a:hover,.archive-item a:hover,.read-link:hover,.archive-link:hover{color:var(--accent)}.feature-card p,.post-card p,.archive-item p{color:var(--text-secondary);line-height:1.65}.read-link{display:inline-block;margin-top:.5rem;font-weight:800}.topic-group{display:grid;grid-template-columns:minmax(220px,.32fr) minmax(0,1fr);gap:2rem;padding:2rem 0;border-top:1px solid var(--border)}.topic-group:first-of-type{border-top:0}.topic-intro h3{font-size:1.45rem;margin:0 0 .5rem}.post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}.post-card{padding:1.2rem}.post-card h4{font-size:1.18rem;margin:.35rem 0 .6rem}.adjacent{background:linear-gradient(90deg,transparent,var(--bg-secondary),transparent)}.archive-item{padding:1.3rem 0;border-top:1px solid var(--border);max-width:850px}.archive-item h3{margin:.35rem 0;font-size:1.4rem}.archive-link{display:inline-block;margin-top:1.5rem;color:var(--accent);font-weight:800}@media(max-width:850px){.section-heading,.topic-group{grid-template-columns:1fr}.feature-grid,.post-grid{grid-template-columns:1fr}.topic-group{gap:.75rem}.page-header h1{font-size:clamp(2.6rem,13vw,4.2rem)}}</style>