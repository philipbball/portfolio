---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;

const sections = [
  { name: 'Writing', path: 'blog/', description: 'Essays, evidence projects and selected public posts' },
  { name: 'Projects', path: 'projects/', description: 'Applied research and analytical tools' },
  { name: 'Publications', path: 'publications/', description: 'Academic papers and published work' },
  { name: 'Talks', path: 'talks/', description: 'Conference talks and presentations' },
  { name: 'CV', path: 'cv/', description: 'Professional background' },
  { name: 'Leadership', path: 'leadership/', description: 'Leadership, service and working principles' },
  { name: 'Travel', path: 'travel/', description: 'Travel stories and observations' },
  { name: 'Experiments', path: 'experiments/', description: 'Experimental projects and ideas' },
];
---

<BaseLayout title="Content" description="Explore all content sections">
  <div class="content-sections">
    <span class="eyebrow">Explore</span>
    <h1>All sections</h1>
    <div class="sections-list">
      {sections.map((section) => (
        <a href={`${base}${section.path}`} class="section-link">
          <div class="section-item">
            <h2>{section.name}</h2>
            <p>{section.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .content-sections{width:min(var(--site-width),calc(100% - 2rem));margin:0 auto;padding:clamp(2.5rem,7vw,5rem) 0}.eyebrow{text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-size:.75rem;font-weight:800}.content-sections h1{font-size:clamp(2.7rem,7vw,5rem);line-height:.98;letter-spacing:-.05em;margin:.5rem 0 2.5rem}.sections-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.section-link{text-decoration:none;color:inherit;transition:transform .2s}.section-link:hover{transform:translateY(-3px)}.section-item{height:100%;padding:1.5rem;background:var(--bg-secondary);border-radius:16px;border:1px solid var(--border);transition:border-color .2s,box-shadow .2s}.section-link:hover .section-item{border-color:var(--accent);box-shadow:0 8px 24px rgba(0,0,0,.08)}.section-item h2{margin:0 0 .5rem;font-size:1.4rem}.section-item p{color:var(--text-secondary);margin:0}@media(max-width:700px){.sections-list{grid-template-columns:1fr}}
</style>