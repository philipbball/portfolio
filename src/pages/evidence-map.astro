---
import BaseLayout from '../layouts/BaseLayout.astro';
import studiesData from '../../public/data/evidence/studies.json';
import pathwaysData from '../../public/data/evidence/pathways.json';

const labels = {
  devolution: 'Change in decision rights', 'local-decisions': 'Decisions closer to place', integration: 'Integrated delivery', prevention: 'Earlier intervention', outcomes: 'Public outcomes',
  'fiscal-autonomy': 'Revenue responsibility', investment: 'Local investment', growth: 'Economic outcomes', capacity: 'Institutional capability', 'effective-devolution': 'Effective use of powers',
  data: 'Timely data', accountability: 'Usable accountability', performance: 'Performance', equalisation: 'Equalisation', fairness: 'Fairness between places',
  stewardship: 'System stewardship', 'system-learning': 'System learning', 'culture-sport': 'Culture and sport activity', 'place-outcomes': 'Place outcomes'
};

const groups = [
  { title: 'Decision rights, integration and prevention', description: 'How changes in authority and coordination might travel through service design to outcomes.', ids: ['p1','p2','p3','p4'] },
  { title: 'Resources, investment and distribution', description: 'How fiscal incentives and investment interact with growth, risk-sharing and fairness.', ids: ['p5','p6','p10'] },
  { title: 'Capability, data and accountability', description: 'The institutional conditions that affect whether expected benefits materialise in practice.', ids: ['p7','p8','p9','p11'] },
  { title: 'Portfolio-specific pathways', description: 'Where sector evidence needs to be built separately rather than inferred from a generic reform theory.', ids: ['p12'] }
];

const studies = new Map(studiesData.studies.map((study) => [study.id, study]));
---

<BaseLayout title="Public Value Evidence Lab — Phil Ball" description="A reusable evidence map for tracing expected benefits through mechanisms, conditions, indicators and outcomes">
  <div class="evidence-shell">
    <header class="hero">
      <span class="eyebrow">Public Value Evidence Lab</span>
      <h1>From expected benefits to realised value.</h1>
      <p class="lede">Policy, investment and organisational reforms usually begin with an expected benefit. The difficult part is the chain in between. This lab makes that chain inspectable: <strong>mechanism → conditions → leading indicators → outcomes → learning.</strong></p>
      <div class="scope-note"><strong>Purpose</strong><p>This is a public-source analytical framework for understanding evidence and implementation under uncertainty. It is designed to surface what is known, what is transferable and what needs to be monitored—not to label a policy or reform as politically right or wrong.</p></div>
    </header>

    <section class="principle card">
      <span class="eyebrow">Working principle</span>
      <h2>Expected benefits are hypotheses to manage, not assumptions to bank.</h2>
      <div class="flow" aria-label="Active benefits management pathway">
        <span>Expected benefit</span><i>→</i><span>Mechanism</span><i>→</i><span>Conditions</span><i>→</i><span>Lead indicators</span><i>→</i><span>Outcome</span><i>→</i><strong>Adapt and learn</strong>
      </div>
    </section>

    <section class="applications">
      <div class="section-heading"><span class="eyebrow">Reusable architecture</span><h2>One framework, different public-value questions.</h2><p>The evidence needed will differ by application, but the discipline is the same: separate the intended result from the causal pathway and the conditions needed to realise it.</p></div>
      <div class="application-grid">
        <article><strong>Public investment</strong><span>Additionality · delivery · distribution · long-run value</span></article>
        <article><strong>Prevention</strong><span>Lead indicators · time lags · cross-budget benefits</span></article>
        <article><strong>Institutional reform</strong><span>Decision rights · capability · accountability · transition</span></article>
        <article><strong>AI and technology</strong><span>Adoption · workflow change · capability · realised productivity</span></article>
        <article><strong>Place-based policy</strong><span>Need · readiness · mechanism · marginal value</span></article>
        <article><strong>Service integration</strong><span>Coordination · access · outcomes · system cost</span></article>
      </div>
    </section>

    <section class="worked-example">
      <div class="section-heading"><span class="eyebrow">Worked example 01 · Devolution and place</span><h2>What should implementation monitor along the pathway?</h2><p>This existing evidence set uses English and international research on devolution, integration, fiscal arrangements and institutional capability to demonstrate the framework. Confidence describes the evidence for a connection—not the desirability of the reform.</p></div>

      <div class="groups">
        {groups.map((group) => (
          <section class="group card">
            <header><h3>{group.title}</h3><p>{group.description}</p></header>
            <div class="pathway-list">
              {pathwaysData.pathways.filter((p) => group.ids.includes(p.id)).map((p) => (
                <details class={`pathway confidence-${p.confidence}`}>
                  <summary>
                    <span class="route"><strong>{labels[p.source]}</strong><i aria-hidden="true">→</i><strong>{labels[p.target]}</strong></span>
                    <b>{p.confidence} confidence</b>
                  </summary>
                  <div class="pathway-body">
                    <h4>Evidence note</h4>
                    <p>{p.synopsis}</p>
                    <h4>What to learn or monitor</h4>
                    <p>{p.gap}</p>
                    {(p.directEvidence.length > 0 || p.indirectEvidence.length > 0) && <h4>Selected evidence</h4>}
                    <div class="source-grid">
                      {[...p.directEvidence.map((id) => ({id, kind: 'Direct / closer evidence'})), ...p.indirectEvidence.map((id) => ({id, kind: 'Indirect / transferable evidence'}))].map(({id,kind}) => {
                        const source = studies.get(id);
                        return source ? <article><small>{kind}</small><a href={source.url} target="_blank" rel="noreferrer"><strong>{source.title} ↗</strong></a><span>{source.authors} · {source.year}</span><p>{source.caveats}</p></article> : null;
                      })}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="how-to-use card">
      <span class="eyebrow">How to read the lab</span>
      <h2>Separate ambition, evidence and management response.</h2>
      <div class="use-grid">
        <article><strong>1 · Ambition</strong><p>What benefit is expected, for whom and over what period?</p></article>
        <article><strong>2 · Evidence</strong><p>Which links have strong direct evidence, which are mixed, and which rely on transfer from other settings?</p></article>
        <article><strong>3 · Conditions</strong><p>What capability, incentives, coordination, data or distributional safeguards must hold?</p></article>
        <article><strong>4 · Monitoring</strong><p>Which leading indicators would tell us early whether the mechanism is actually operating?</p></article>
        <article><strong>5 · Learning</strong><p>What evidence would justify scaling, redesigning, supporting, pausing or remediating an element?</p></article>
        <article><strong>6 · Public value</strong><p>Track outcomes, costs, distribution, spillovers and opportunity cost rather than a single headline metric.</p></article>
      </div>
    </section>
  </div>

  <style>
    .evidence-shell{width:min(var(--site-width),calc(100% - 2rem));margin:0 auto;padding:0 0 5rem}.hero{padding:clamp(3rem,7vw,6rem) 0 2rem}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.72rem;font-weight:800;color:var(--accent)}.hero h1{font-size:clamp(3rem,8vw,6.5rem);line-height:.92;letter-spacing:-.06em;margin:.6rem 0 1.2rem;max-width:1000px}.lede{font-size:clamp(1.05rem,2vw,1.25rem);line-height:1.7;color:var(--text-secondary);max-width:900px}.scope-note{margin-top:1.5rem;padding:1.1rem 1.2rem;border-left:4px solid var(--accent);background:var(--bg-secondary);border-radius:10px}.scope-note p{margin:.35rem 0;color:var(--text-secondary);line-height:1.6}.card{background:var(--bg-secondary);border:1px solid var(--border);border-radius:18px}.principle{padding:clamp(1.25rem,3vw,2rem);border-top:5px solid var(--accent)}.principle h2,.section-heading h2,.how-to-use h2{font-size:clamp(1.8rem,4vw,3.2rem);letter-spacing:-.04em;margin:.4rem 0 1rem}.flow{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;margin-top:1.2rem}.flow span,.flow strong{padding:.65rem .75rem;background:var(--bg-primary);border:1px solid var(--border);border-radius:9px}.flow i{font-style:normal;color:var(--accent);font-weight:900}.applications,.worked-example,.how-to-use{margin-top:clamp(3rem,7vw,5.5rem)}.section-heading{max-width:900px;margin-bottom:1.5rem}.section-heading p{color:var(--text-secondary);line-height:1.65}.application-grid,.use-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}.application-grid article,.use-grid article{padding:1rem;border:1px solid var(--border);border-radius:13px;background:var(--bg-secondary);display:grid;gap:.35rem}.application-grid span,.use-grid p{color:var(--text-secondary);line-height:1.5;margin:0}.groups{display:grid;gap:1rem}.group{overflow:hidden}.group>header{padding:1.1rem 1.2rem;border-bottom:1px solid var(--border)}.group h3{margin:0 0 .35rem;font-size:1.3rem}.group header p{margin:0;color:var(--text-secondary)}.pathway-list{display:grid}.pathway{border-bottom:1px solid var(--border)}.pathway:last-child{border-bottom:0}.pathway summary{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.2rem;cursor:pointer;list-style:none}.pathway summary::-webkit-details-marker{display:none}.route{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}.route i{font-style:normal;color:var(--accent)}.pathway summary>b{font-size:.75rem;text-transform:capitalize;padding:.35rem .5rem;border:1px solid var(--border);border-radius:999px;white-space:nowrap}.pathway-body{padding:0 1.2rem 1.25rem;background:var(--bg-primary);border-top:1px solid var(--border)}.pathway-body h4{margin:1rem 0 .4rem}.pathway-body>p{color:var(--text-secondary);line-height:1.6}.source-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.65rem}.source-grid article{padding:.8rem;border:1px solid var(--border);border-radius:10px;background:var(--bg-secondary);display:grid;gap:.35rem}.source-grid small{color:var(--accent);font-weight:800;text-transform:uppercase}.source-grid a{color:var(--text-primary);text-decoration:none}.source-grid a:hover{color:var(--accent)}.source-grid span,.source-grid p{font-size:.82rem;color:var(--text-secondary);line-height:1.45;margin:0}.how-to-use{padding:1.3rem}.how-to-use h2{font-size:2rem}@media(max-width:800px){.application-grid,.use-grid{grid-template-columns:1fr 1fr}.source-grid{grid-template-columns:1fr}.pathway summary{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.application-grid,.use-grid{grid-template-columns:1fr}.flow{align-items:stretch;flex-direction:column}.flow i{transform:rotate(90deg);align-self:center}}
  </style>
</BaseLayout>