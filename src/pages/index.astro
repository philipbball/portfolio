---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Phil Ball, PhD — Strategic economist" description="Strategic economist working across public value, investment, place, resilience and institutional decision-making">
  <div class="home-shell">
    <section class="hero" id="top">
      <div class="hero-copy">
        <span class="eyebrow">Strategic economist · London</span>
        <h1>Better decisions<br/><em>under uncertainty.</em></h1>
        <p>I help institutions allocate capital, navigate trade-offs and deliver long-term economic, social and environmental value.</p>
        <div class="hero-actions">
          <a class="button primary" href="#work">Explore selected work</a>
          <a class="button secondary" href={`${base}projects/`}>View projects</a>
        </div>
      </div>
      <div class="decision-card" aria-label="Working approach">
        <span>Evidence</span><i>→</i><span>Trade-offs</span><i>→</i><strong>Decision</strong><i>→</i><strong>Value</strong>
      </div>
    </section>

    <section class="proof-grid" aria-label="Professional summary">
      <article><strong>15+ years</strong><span>Government, public investment, consultancy and academia</span></article>
      <article><strong>Core focus</strong><span>Public value · Investment · Place · Resilience</span></article>
    </section>

    <section class="content-section" id="work">
      <div class="section-intro">
        <div><span class="eyebrow">Selected work</span><h2>Economics that survives contact with institutions.</h2></div>
        <p>The technical answer is rarely the whole answer. My work connects evidence, incentives, delivery capacity and accountability so analysis can change real decisions.</p>
      </div>
      <div class="work-grid">
        <article><small>01 · Capital allocation</small><h3>Public investment and impact</h3><p>Helped establish and scale the impact function at the UK Infrastructure Bank, now the National Wealth Fund, supporting infrastructure decisions across energy, transport and digital investment.</p><div class="tags"><span>Impact</span><span>Resilience</span><span>Risk and return</span></div></article>
        <article><small>02 · Institutions and delivery</small><h3>Place and financial sustainability</h3><p>Work spanning place, funding, financial sustainability and analytical strategy: understanding additional value, local capacity constraints and responsible transitions.</p><div class="tags"><span>Place</span><span>Prevention</span><span>Transitions</span></div></article>
        <article><small>03 · Decision architecture</small><h3>Public value and value for money</h3><p>Appraisal, economic analysis, impact assessment and public-sector reform—turning imperfect evidence into decisions that are defensible, deliverable and alert to implementation.</p><div class="tags"><span>Appraisal</span><span>VfM</span><span>Implementation</span></div></article>
        <article class="featured-project"><small>04 · Evidence project</small><h3><a href={`${base}projects/rewiring-the-state-evidence/`}>Rewiring the State</a></h3><p>A full rapid evidence assessment of when devolution, integration and fiscal reform can create public value, with an accessible cross-government evidence landscape.</p><div class="tags"><span>39 sources</span><span>International evidence</span><span>Interactive</span></div><a class="project-link" href={`${base}projects/rewiring-the-state-evidence/`}>Explore the assessment <span aria-hidden="true">→</span></a></article>
      </div>
    </section>

    <section class="content-section ideas" id="ideas">
      <div class="section-intro">
        <div><span class="eyebrow">Ideas and research</span><h2>What sits between evidence and outcomes?</h2></div>
        <p>I am interested in the institutional layer that standard models often compress: power, capability, incentives, path dependence and practical trade-offs.</p>
      </div>
      <blockquote>“Standardise the plumbing. Localise the decisions.”<footer>A working principle for data, AI and public-service reform</footer></blockquote>
      <div class="question-grid">
        <article><small>Question 01</small><h3>When does “what works” stop being enough?</h3><p>Evidence must be actively managed through theory of change, lead indicators and implementation—not treated as a passive label.</p></article>
        <article><small>Question 02</small><h3>Is local capacity the binding constraint?</h3><p>Technology can scale quickly; institutional capability cannot. Reform must design for that asymmetry.</p></article>
        <article><small>Question 03</small><h3>How should support evolve?</h3><p>Good stewardship means knowing when to sustain, adapt, taper or transition support without confusing withdrawal with success.</p></article>
      </div>
    </section>

    <section class="content-section" id="experience">
      <div class="section-intro">
        <div><span class="eyebrow">Experience</span><h2>Across policy, capital and practice.</h2></div>
        <p>A career built across different institutional vantage points, with a consistent focus on consequential choices under constraint.</p>
      </div>
      <div class="timeline">
        <article><small>Now</small><h3>UK Civil Service · Government Economic Service · DCMS</h3><p>Strategic economics spanning place, financial sustainability, analytical strategy and evidence-informed decision-making.</p></article>
        <article><small>Public investment</small><h3>UK Infrastructure Bank · now National Wealth Fund</h3><p>Helped establish and scale the impact function, connecting impact, resilience and public value with investment risk and return.</p></article>
        <article><small>Consultancy and government</small><h3>Simetrica–Jacobs · EY · HM Treasury</h3><p>Economic appraisal, impact assessment, regulation, value for money and public-sector strategy, alongside experience in major delivery departments.</p></article>
        <article><small>Academic foundation</small><h3>University of Nottingham</h3><p>PhD in Economics and Visiting Fellow at Nottingham University Business School, bridging academic evidence, policy and practice.</p></article>
      </div>
    </section>

    <section class="content-section about" id="about">
      <div class="section-intro"><div><span class="eyebrow">About · He/Him</span><h2>How can institutions make better decisions under uncertainty?</h2></div></div>
      <div class="about-grid">
        <div><p>The hardest challenges facing governments, investors and organisations are rarely purely technical. More often, they are problems of incentives, institutions and implementation.</p><p>My work sits at the intersection of economics, investment, public value and strategy. My experience of neurodiversity has reinforced my belief that high-performing organisations combine cognitive diversity, analytical rigour and accountability for delivery.</p></div>
        <div class="principles"><article><strong>Evidence is necessary, not sufficient.</strong><span>Institutions still need judgement, learning and accountability.</span></article><article><strong>Implementation is part of strategy.</strong><span>Capacity and incentives shape what is genuinely possible.</span></article><article><strong>Trade-offs should be visible.</strong><span>Plural value requires explicit choices, not false precision.</span></article></div>
      </div>
    </section>

    <section class="contact" id="contact">
      <span class="eyebrow">Contact</span><h2>Let’s work on a difficult decision.</h2><p>I welcome collaboration across government, academia, industry and the third sector.</p>
      <div class="hero-actions"><a class="button primary" href="https://www.linkedin.com/in/philipbball/" target="_blank" rel="noreferrer">Connect on LinkedIn</a><a class="button secondary" href={`${base}publications/`}>Explore research</a></div>
    </section>
  </div>

  <style>
    .home-shell{max-width:1380px;margin:0 auto;padding:0 clamp(1rem,3vw,2.5rem) 5rem}.hero{min-height:70vh;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:3rem;align-items:center;padding:clamp(3rem,8vw,7rem) 0 4rem}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.72rem;font-weight:800;color:var(--accent)}.hero h1{font-size:clamp(3.3rem,8vw,7.2rem);line-height:.89;letter-spacing:-.065em;margin:.7rem 0 1.7rem}.hero h1 em{font-style:normal;color:var(--accent)}.hero-copy>p{font-size:clamp(1.05rem,2vw,1.28rem);line-height:1.65;max-width:760px;color:var(--text-secondary)}.hero-actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.6rem}.button{display:inline-block;padding:.85rem 1.1rem;border-radius:12px;text-decoration:none;font-weight:750;border:1px solid var(--border)}.button.primary{background:var(--accent);color:white;border-color:var(--accent)}.button.secondary{background:var(--bg-secondary)}.decision-card{display:grid;grid-template-columns:1fr auto;gap:1rem;padding:1.5rem;border:1px solid var(--border);border-radius:24px;background:var(--bg-secondary);box-shadow:0 18px 50px rgba(20,32,51,.08)}.decision-card i{color:var(--accent);font-style:normal}.decision-card strong{color:var(--accent)}.proof-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.proof-grid article{padding:1.2rem;display:grid;gap:.25rem}.proof-grid article+article{border-left:1px solid var(--border)}.proof-grid span{color:var(--text-secondary)}.content-section{padding:clamp(4rem,8vw,7rem) 0;border-bottom:1px solid var(--border)}.section-intro{display:grid;grid-template-columns:1.4fr .8fr;gap:2rem;align-items:end;margin-bottom:2rem}.section-intro h2,.contact h2{font-size:clamp(2.2rem,5vw,4.8rem);letter-spacing:-.045em;margin:.4rem 0}.section-intro>p{color:var(--text-secondary);line-height:1.65}.work-grid,.question-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.work-grid article,.question-grid article{padding:1.4rem;border:1px solid var(--border);border-radius:20px;background:var(--bg-secondary)}small{color:var(--accent);font-weight:750;text-transform:uppercase;letter-spacing:.08em}.work-grid h3,.question-grid h3{font-size:1.45rem}.work-grid p,.question-grid p,.timeline p,.contact p{color:var(--text-secondary);line-height:1.65}.tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1rem}.tags span{padding:.3rem .55rem;border-radius:999px;border:1px solid var(--border);font-size:.75rem}.ideas blockquote{font-size:clamp(1.8rem,4vw,3.8rem);line-height:1.15;letter-spacing:-.035em;margin:2.5rem 0;padding-left:1.2rem;border-left:5px solid var(--accent)}blockquote footer{font-size:.85rem;letter-spacing:0;color:var(--text-secondary);margin-top:1rem}.timeline{display:grid}.timeline article{display:grid;grid-template-columns:150px 1fr 1.2fr;gap:1.5rem;padding:1.5rem 0;border-top:1px solid var(--border)}.timeline h3{margin:0}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}.about-grid p{font-size:1.08rem;line-height:1.75}.principles{display:grid;gap:.75rem}.principles article{padding:1rem;border:1px solid var(--border);border-radius:14px;background:var(--bg-secondary);display:grid;gap:.35rem}.principles span{color:var(--text-secondary)}.contact{padding:clamp(4rem,8vw,7rem) 0}.contact p{font-size:1.1rem}.navbar{backdrop-filter:blur(16px)}
    .work-grid .featured-project{grid-column:1/-1;border-top:4px solid var(--accent)}.featured-project h3 a,.project-link{color:var(--text-primary);text-decoration:none}.featured-project h3 a:hover,.project-link:hover{color:var(--accent)}.project-link{display:inline-block;margin-top:1rem;font-weight:800}
    @media(max-width:900px){.hero,.section-intro,.about-grid{grid-template-columns:1fr}.hero{min-height:auto}.work-grid,.question-grid{grid-template-columns:1fr}.timeline article{grid-template-columns:1fr;gap:.45rem}.proof-grid{grid-template-columns:1fr}.proof-grid article+article{border-left:0;border-top:1px solid var(--border)}}
    @media(max-width:520px){.hero h1{font-size:clamp(2.8rem,15vw,4.2rem)}.decision-card{grid-template-columns:1fr auto}.hero-actions .button{width:100%;text-align:center}}
  </style>
</BaseLayout>
