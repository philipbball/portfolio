---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leadership — Phil Ball" description="Leadership, service and working principles">
  <div class="section-page">
    <span class="eyebrow">Leadership and service</span><h1>Building capability around difficult decisions</h1>
    <p class="intro">My leadership work connects analytical standards with the conditions people and institutions need to use evidence well.</p>
    <div class="cards">
      <article><small>Academic leadership</small><h2>Visiting Fellow</h2><p>Visiting Fellow at Nottingham University Business School, contributing a practitioner perspective across economics, institutions and public value.</p></article>
      <article><small>Professional development</small><h2>Future Leaders Scheme</h2><p>Leadership development focused on working across organisational boundaries, navigating ambiguity and delivering through others.</p></article>
      <article><small>Community</small><h2>Network leadership</h2><p>Supporting inclusive professional networks and creating the conditions for people with different perspectives to contribute and thrive.</p></article>
      <article><small>Governance</small><h2>Trustee and Treasurer</h2><p>Board-level stewardship, financial oversight and accountability in the third sector.</p></article>
    </div>
    <section class="principles"><h2>Working principles</h2><div><p><strong>Evidence is necessary, not sufficient.</strong> Institutions also need judgement, learning and accountability.</p><p><strong>Implementation is part of strategy.</strong> Capability and incentives shape what is genuinely possible.</p><p><strong>Trade-offs should be visible.</strong> Public value requires explicit choices rather than false precision.</p></div></section>
  </div>
</BaseLayout>

<style>
  .section-page{width:min(var(--site-width),calc(100% - 2rem));margin:0 auto;padding:clamp(2.5rem,7vw,5rem) 0}.eyebrow,small{text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-size:.75rem;font-weight:800}.section-page>h1{font-size:clamp(2.7rem,7vw,5rem);line-height:.98;letter-spacing:-.05em;margin:.5rem 0;max-width:900px}.intro{font-size:1.15rem;line-height:1.7;color:var(--text-secondary);max-width:760px}.cards{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:3rem}.cards article{padding:1.4rem;border:1px solid var(--border);border-radius:18px;background:var(--bg-secondary)}.cards h2{font-size:1.4rem}.cards p,.principles p{color:var(--text-secondary);line-height:1.65}.principles{margin-top:4rem;padding-top:2rem;border-top:1px solid var(--border)}.principles>div{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}@media(max-width:720px){.cards,.principles>div{grid-template-columns:1fr}}
</style>