---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const departments = {
  co: 'Cabinet Office', dcms: 'Department for Culture, Media and Sport', dbt: 'Department for Business and Trade',
  dfe: 'Department for Education', dhsc: 'Department of Health and Social Care', dft: 'Department for Transport', dwp: 'Department for Work and Pensions',
  dsit: 'Department for Science, Innovation and Technology', hmt: 'HM Treasury', mhclg: 'Ministry of Housing, Communities and Local Government'
};

const portfolios = {
  youth: 'Children, youth and families', civil: 'Civil society and communities', culture: 'Arts and culture',
  heritage: 'Heritage', sport: 'Sport and physical activity', visitor: 'Visitor economy',
  creative: 'Creative industries', digital: 'Digital infrastructure', transport: 'Transport',
  housing: 'Housing and planning', skills: 'Skills and employment', health: 'Health and social care',
  finance: 'Local government finance', bodies: 'Public bodies and regulation', data: 'Data and digital government'
};

const claims = [
  {
    id: 'tailoring', theme: 'Power and governance', proposition: 'Local power improves tailoring and coordination',
    judgement: 'Supported, conditionally', confidence: 'Moderate', balance: 'supportive',
    conclusion: 'Local information and cross-sector coordination can improve service design, but authority, capability and relationships matter more than proximity alone.',
    mechanism: 'Local knowledge and joined-up decisions', conditions: ['Clear responsibility', 'Capability', 'Cross-boundary coordination'],
    outcomes: ['Better matching', 'Integrated delivery'], direct: 1, indirect: 4,
    portfolios: ['youth','civil','culture','heritage','sport','visitor','creative','digital','transport','housing','skills','health'],
    departments: ['mhclg','dcms','dhsc','dfe','dft','dsit'],
    sources: [
      {name: 'BEIS/Warwick — Evaluation of Devolved Institutions (2021)', url: 'https://assets.publishing.service.gov.uk/media/609c083ae90e0735772d9c91/evaluation-devolved-institutions.pdf', kind: 'Direct England'},
      {name: 'OECD — Making Decentralisation Work (2019)', url: 'https://doi.org/10.1787/g2g9faa7-en', kind: 'International transfer'}
    ],
    transfer: 'Comparable systems support the mechanism, but responsibility allocation, fiscal autonomy and subnational scale must be matched to England.'
  },
  {
    id: 'growth', theme: 'Growth and functional devolution', proposition: 'Devolution accelerates growth',
    judgement: 'Mixed / not established generally', confidence: 'Moderate', balance: 'mixed',
    conclusion: 'English estimates conflict. Some first-wave City Deals show gains, while other designs find null or uneven effects and stronger gains in already-productive places.',
    mechanism: 'Coherent local investment and agglomeration', conditions: ['Mature institutions', 'Functional geography', 'Additionality'],
    outcomes: ['Productivity', 'Employment', 'Spatial distribution'], direct: 2, indirect: 6,
    portfolios: ['culture','heritage','visitor','creative','digital','transport','housing','skills','finance'],
    departments: ['mhclg','hmt','dbt','dft','dcms','dsit','dfe'],
    sources: [
      {name: 'Alonso and Andrews — City Deals and economic performance (2024)', url: 'https://orca.cardiff.ac.uk/id/eprint/161102/1/City%20deals%20paper%20-%20Alonso%20and%20Andrews.doc.pdf', kind: 'Direct England'},
      {name: 'Sweeney — Devolution and growth in English city regions (2026)', url: 'https://doi.org/10.1177/00420980251408416', kind: 'Direct England'},
      {name: 'OECD — Place-Based Policies for the Future (2025)', url: 'https://doi.org/10.1787/e5ff6716-en', kind: 'International synthesis'}
    ],
    transfer: 'International place-policy and fiscal studies are useful for mechanisms, but effects depend heavily on autonomy, institutional quality and economic geography.'
  },
  {
    id: 'integration', theme: 'Integrated services and prevention', proposition: 'Integrated services improve outcomes',
    judgement: 'Partly supported', confidence: 'Moderate', balance: 'supportive',
    conclusion: 'Evidence is more positive for access, user experience and selected population-health outcomes than for system-wide costs or cashable savings.',
    mechanism: 'Alignment across services and budgets', conditions: ['Shared data', 'Trusted relationships', 'Sufficient resources'],
    outcomes: ['Access', 'User experience', 'Population health'], direct: 5, indirect: 2,
    portfolios: ['youth','civil','sport','health','skills','housing','data'], departments: ['dhsc','mhclg','dfe','dcms','dwp','dsit'],
    sources: [
      {name: 'Britteon et al. — Effect of devolution on health (2022)', url: 'https://doi.org/10.1016/S2468-2667(22)00198-0', kind: 'Direct England'},
      {name: 'Baxter et al. — Integrated care systematic review (2018)', url: 'https://doi.org/10.1186/s12913-018-3161-3', kind: 'UK and international'}
    ],
    transfer: 'Greater Manchester is the most promising direct case, but its maturity, relationships and additional funding constrain generalisation.'
  },
  {
    id: 'prevention', theme: 'Integrated services and prevention', proposition: 'Prevention reduces later costs',
    judgement: 'Supported for selected interventions', confidence: 'Moderate', balance: 'supportive',
    conclusion: 'Some preventive programmes produce substantial long-run benefits; this does not show that devolving budgets automatically shifts spending upstream or creates cashable savings.',
    mechanism: 'Earlier action reduces later harm', conditions: ['Protected time horizon', 'Cross-budget attribution', 'Benefits tracked'],
    outcomes: ['Long-run wellbeing', 'Avoided demand', 'Public value'], direct: 2, indirect: 1,
    portfolios: ['youth','civil','sport','health','housing'], departments: ['dhsc','dfe','dcms','mhclg','dwp'],
    sources: [
      {name: 'IFS — Long-run effects of Sure Start (2025)', url: 'https://ifs.org.uk/publications/short-and-medium-term-effects-sure-start-childrens-outcomes', kind: 'Direct England'},
      {name: 'Masters et al. — Public-health return on investment review (2017)', url: 'https://doi.org/10.1136/jech-2016-208141', kind: 'International synthesis'}
    ],
    transfer: 'Programme effects transfer more readily than claims about which tier of government will commission or sustain prevention.'
  },
  {
    id: 'fiscal', theme: 'Fiscal devolution', proposition: 'Fiscal devolution strengthens incentives',
    judgement: 'Plausible, design-dependent', confidence: 'Moderate', balance: 'conditional',
    conclusion: 'Revenue autonomy can improve incentives when it matches spending responsibility; volatility and unequal tax bases require equalisation, insurance and transition rules.',
    mechanism: 'Visible link between decisions and resources', conditions: ['Revenue–spending alignment', 'Equalisation', 'Shock protection'],
    outcomes: ['Incentives', 'Funding certainty', 'Fiscal resilience'], direct: 3, indirect: 2,
    portfolios: ['finance','housing','transport','skills','culture','digital'], departments: ['hmt','mhclg','dft','dfe','dcms','dsit'],
    sources: [
      {name: 'IFS — Reforming local government funding (2024)', url: 'https://ifs.org.uk/publications/reforming-local-government-funding-england-issues-and-options', kind: 'Direct England'},
      {name: 'OECD — Fiscal federalism good practices (2020)', url: 'https://doi.org/10.1787/89cd0319-en', kind: 'International synthesis'}
    ],
    transfer: 'Fiscal evidence must be coded for real tax autonomy, equalisation, revenue composition and risks outside local control.'
  },
  {
    id: 'equity', theme: 'Equalisation and spatial equity', proposition: 'Devolution improves spatial equity',
    judgement: 'Uncertain and conditional', confidence: 'Low–Moderate', balance: 'mixed',
    conclusion: 'Strong institutions and redistribution can limit divergence, but English evidence also indicates that gains may concentrate in stronger districts within combined authorities.',
    mechanism: 'Local flexibility plus redistribution', conditions: ['Transparent equalisation', 'Within-place distribution', 'Comparable service capacity'],
    outcomes: ['Fair access', 'Regional convergence', 'Within-region equity'], direct: 2, indirect: 2,
    portfolios: ['finance','housing','skills','transport','youth','health'], departments: ['hmt','mhclg','dwp','dfe','dhsc','dft'],
    sources: [
      {name: 'Sweeney — Devolution and growth in English city regions (2026)', url: 'https://doi.org/10.1177/00420980251408416', kind: 'Direct England'},
      {name: 'Rodríguez-Pose and Ezcurra — Regional disparities (2010)', url: 'https://doi.org/10.1093/jeg/lbp049', kind: 'International econometric'}
    ],
    transfer: 'Constitutional structure and redistributive capacity are decisive; international averages should not be applied directly to English administrative devolution.'
  },
  {
    id: 'accountability', theme: 'Accountability, outcomes and data', proposition: 'Local democratic accountability improves',
    judgement: 'Supported as a mechanism', confidence: 'Moderate', balance: 'conditional',
    conclusion: 'Transparent, actionable information and real consequences can change behaviour. Elections alone are insufficient when responsibility is opaque or scrutiny is weak.',
    mechanism: 'Information reaches people able to act', conditions: ['Legible responsibility', 'Independent audit', 'Usable measures'],
    outcomes: ['Scrutiny', 'Behaviour change', 'Trust'], direct: 4, indirect: 3,
    portfolios: ['civil','youth','data','bodies','finance'], departments: ['mhclg','hmt','co','dcms','dsit'],
    sources: [
      {name: 'NAO — English devolution deals (2016)', url: 'https://www.nao.org.uk/reports/english-devolution-deals/', kind: 'Direct England'},
      {name: 'Ferraz and Finan — Public audits and elections (2008)', url: 'https://doi.org/10.1162/qjec.2008.123.2.703', kind: 'International mechanism'}
    ],
    transfer: 'Global experiments test information and accountability mechanisms, not the overall English governance model.'
  },
  {
    id: 'capability', theme: 'Capability and readiness', proposition: 'Strong local capability is a prerequisite',
    judgement: 'Supported', confidence: 'High', balance: 'supportive',
    conclusion: 'Capability is one of the most consistent findings across English audits, evaluations and international synthesis—and should be treated as part of the reform, not assumed in advance.',
    mechanism: 'Institutions can use powers and coordinate delivery', conditions: ['Analytical capacity', 'Commercial and digital skills', 'Scrutiny capacity'],
    outcomes: ['Effective use of powers', 'Delivery resilience', 'Learning'], direct: 3, indirect: 3,
    portfolios: Object.keys(portfolios), departments: Object.keys(departments),
    sources: [
      {name: 'NAO — Devolution in England: funding and accountability (2026)', url: 'https://www.nao.org.uk/reports/devolution-in-england-funding-and-accountability/', kind: 'Direct England'},
      {name: 'OECD — Regional Governance in OECD Countries (2022)', url: 'https://doi.org/10.1787/4d7c6483-en', kind: 'International synthesis'}
    ],
    transfer: 'The capability principle transfers well, but the specific functions and viable subnational scale remain context-dependent.'
  },
  {
    id: 'centre', theme: 'Strategic centre and public bodies', proposition: 'A smaller strategic centre improves performance',
    judgement: 'Evidence gap', confidence: 'Low', balance: 'gap',
    conclusion: 'Evidence supports a different centre—clear responsibilities, common data, equalisation, assurance and stewardship—not headcount reduction as a proxy for outcomes.',
    mechanism: 'Central stewardship enables local discretion', conditions: ['National standards', 'Interoperable data', 'System-risk oversight'],
    outcomes: ['Less duplication', 'Resilience', 'System learning'], direct: 2, indirect: 2,
    portfolios: ['bodies','data','finance','civil','digital'], departments: ['co','hmt','mhclg','dsit','dcms'],
    sources: [
      {name: 'NAO — Devolution in England: funding and accountability (2026)', url: 'https://www.nao.org.uk/reports/devolution-in-england-funding-and-accountability/', kind: 'Direct England'},
      {name: 'OECD — Steering from the Centre (2014)', url: 'https://doi.org/10.1787/5jxswcfs4s5g-en', kind: 'International cases'}
    ],
    transfer: 'Comparative cases support central coordination and learning functions, but do not identify an optimal centre size.'
  },
  {
    id: 'alb', theme: 'Strategic centre and public bodies', proposition: 'Moving arm’s-length-body functions improves delivery',
    judgement: 'Evidence gap', confidence: 'Very low', balance: 'gap',
    conclusion: 'Existing evidence concerns choosing and overseeing delivery models, not the net effects of moving functions to places or departments. Function-by-function tests are needed.',
    mechanism: 'Responsibility follows the effective delivery scale', conditions: ['Independence test', 'Baseline cost and performance', 'Transition risk'],
    outcomes: ['Clearer roles', 'Delivery quality', 'Public value'], direct: 1, indirect: 0,
    portfolios: ['bodies','culture','heritage','sport','digital','health'], departments: ['co','hmt','dcms','dsit','dhsc','mhclg'],
    sources: [
      {name: 'NAO — Central oversight of arm’s-length bodies (2021)', url: 'https://www.nao.org.uk/reports/central-oversight-of-arms-length-bodies/', kind: 'Relevant UK evidence'}
    ],
    transfer: 'No identified international comparison cleanly estimates the effect of the proposed machinery change.'
  }
];

const payload = { claims, departments, portfolios };
---

<BaseLayout title="Rewiring the State — evidence assessment" description="An independent rapid evidence assessment of the causal claims behind Rewiring the State">
  <div class="rea-shell">
    <header class="hero">
      <div>
        <span class="eyebrow">Full rapid evidence assessment · 39 included sources</span>
        <h1>Rewiring the State: what does the evidence support?</h1>
        <p class="lede">An independent, cross-government assessment of when devolution, integration and fiscal reform are most likely to create public value.</p>
      </div>
      <aside class="scope-note"><strong>Interpretation note</strong><span>This is a personal evidence-method demonstration using public sources. It is not official policy advice or a departmental position.</span></aside>
    </header>

    <section class="bottom-line card" aria-labelledby="bottom-line-title">
      <span class="eyebrow">Conclusion up front</span>
      <h2 id="bottom-line-title">Directionally supported—but only as a conditional institution-building strategy.</h2>
      <p>Moving some decisions closer to place can improve tailoring, coordination and selected outcomes. The evidence does not show that devolution alone reliably creates growth, savings, equity or accountability. Coherent powers, capability, equalisation, usable accountability and transition design determine whether flexibility creates public value.</p>
      <div class="headline-grid">
        <article><small>Strongest support</small><strong>Capability, coherent responsibilities and usable accountability</strong></article>
        <article><small>Most promising direct evidence</small><strong>Integrated health and service alignment in Greater Manchester</strong></article>
        <article><small>Biggest contradiction</small><strong>Growth estimates are mixed and gains may favour stronger places</strong></article>
        <article><small>Largest gap</small><strong>Effects of changing the centre or moving public-body functions</strong></article>
      </div>
    </section>

    <nav class="jump-nav" aria-label="On this page">
      <a href="#landscape">Explore evidence</a><a href="#claims">Claim conclusions</a><a href="#implementation">Implementation</a><a href="#downloads">Downloads</a><a href="#method">Method</a>
    </nav>

    <section id="landscape" class="section-block" aria-labelledby="landscape-title">
      <div class="section-heading"><div><span class="eyebrow">Exploratory overview</span><h2 id="landscape-title">Evidence landscape</h2><p>Start with a claim. Filters show cross-government and portfolio overlaps; selecting a claim opens its evidence-weighted pathway.</p></div><span class="assignment">Department assignments as at 31 July 2026</span></div>

      <details class="filters card" open>
        <summary>Filter the landscape <span id="filterSummary">0 applied</span></summary>
        <div class="filter-grid">
          <label>Theme<select id="themeFilter"><option value="all">All themes</option>{[...new Set(claims.map(c => c.theme))].map(theme => <option value={theme}>{theme}</option>)}</select></label>
          <label>Portfolio<select id="portfolioFilter"><option value="all">All portfolios</option>{Object.entries(portfolios).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
          <label>Department<select id="departmentFilter"><option value="all">All departments</option>{Object.entries(departments).map(([id,label]) => <option value={id}>{label}</option>)}</select></label>
          <label>Evidence balance<select id="balanceFilter"><option value="all">All balances</option><option value="supportive">Supportive</option><option value="conditional">Conditional</option><option value="mixed">Mixed</option><option value="gap">Evidence gap</option></select></label>
          <label>Confidence<select id="confidenceFilter"><option value="all">All confidence levels</option><option value="High">High</option><option value="Moderate">Moderate</option><option value="Low–Moderate">Low–Moderate</option><option value="Low">Low</option><option value="Very low">Very low</option></select></label>
          <label>Search<input id="searchFilter" type="search" placeholder="e.g. prevention or culture" /></label>
        </div>
        <div class="filter-actions"><label class="check"><input id="overlapFilter" type="checkbox" /> Cross-department claims only</label><button id="clearFilters" type="button">Clear filters</button></div>
        <div id="filterChips" class="filter-chips" aria-label="Applied filters"></div>
        <p id="resultCount" class="result-count" role="status" aria-live="polite"></p>
      </details>

      <div class="explorer-layout">
        <section class="claim-picker card" aria-labelledby="picker-title">
          <div class="card-heading"><div><span class="eyebrow">Statement propositions</span><h3 id="picker-title">Choose a claim</h3></div><button id="resetSelection" type="button">Reset view</button></div>
          <div id="claimList" class="claim-list">
            {claims.map(claim => <button class={`claim-node balance-${claim.balance}`} type="button" data-id={claim.id} data-theme={claim.theme} data-portfolios={claim.portfolios.join(',')} data-departments={claim.departments.join(',')} data-balance={claim.balance} data-confidence={claim.confidence} data-search={`${claim.proposition} ${claim.conclusion} ${claim.theme} ${claim.portfolios.map(x => portfolios[x]).join(' ')}`.toLowerCase()} aria-pressed="false"><span>{claim.theme}</span><strong>{claim.proposition}</strong><small>{claim.judgement} · {claim.confidence}</small></button>)}
          </div>
          <div id="noResults" class="no-results" hidden><strong>No evidence matches these filters.</strong><button type="button">Clear all filters</button></div>
        </section>

        <section class="selected-card card" id="selectedCard" tabindex="-1" aria-labelledby="selectedTitle">
          <span id="selectedBalance" class="status-chip">Select a claim</span>
          <h3 id="selectedTitle">How to use the landscape</h3>
          <p id="selectedConclusion">Select any claim on the left. Its selected state will be visibly outlined and its conclusion, causal pathway, transferability and key sources will appear here.</p>
          <dl class="evidence-counts"><div><dt>Direct England</dt><dd id="directCount">—</dd></div><div><dt>Indirect / transferable</dt><dd id="indirectCount">—</dd></div><div><dt>Body confidence</dt><dd id="confidenceValue">—</dd></div></dl>
          <details id="pathwayDetails" class="pathway-disclosure" open>
            <summary>View the selected causal pathway</summary>
            <div class="pathway" aria-label="Causal pathway from claim through mechanism and conditions to outcomes and evidence">
              <div><small>Claim</small><strong id="pathClaim">Select a claim</strong></div><i aria-hidden="true">→</i>
              <div><small>Mechanism</small><strong id="pathMechanism">—</strong></div><i aria-hidden="true">→</i>
              <div><small>Conditions</small><ul id="pathConditions"><li>—</li></ul></div><i aria-hidden="true">→</i>
              <div><small>Intended outcomes</small><ul id="pathOutcomes"><li>—</li></ul></div>
            </div>
          </details>
          <div class="selected-detail"><h4>Transferability</h4><p id="transferNote">International evidence is assessed separately from direct England evidence.</p><h4>Key evidence</h4><div id="sourceList"><p>Sources will appear after selection.</p></div></div>
          <div class="selected-detail"><h4>Department overlap</h4><div id="departmentList" class="filter-chips"><span>Select a claim</span></div><h4>Portfolio overlap</h4><div id="portfolioList" class="filter-chips"><span>Select a claim</span></div></div>
        </section>
      </div>
    </section>

    <section id="claims" class="section-block" aria-labelledby="claims-title">
      <div class="section-heading"><div><span class="eyebrow">Accessible source of truth</span><h2 id="claims-title">Claim-by-claim conclusions</h2><p>Every conclusion is available without using the interactive landscape.</p></div></div>
      <div class="matrix" role="list">
        {claims.map(claim => <details class="claim-card card" role="listitem"><summary><span><small>{claim.theme}</small><strong>{claim.proposition}</strong></span><span class={`matrix-rating balance-${claim.balance}`}>{claim.judgement}<b>{claim.confidence}</b></span></summary><div class="claim-body"><p class="claim-conclusion"><strong>Conclusion:</strong> {claim.conclusion}</p><div class="claim-grid"><div><h3>Conditions</h3><ul>{claim.conditions.map(x => <li>{x}</li>)}</ul></div><div><h3>Evidence coverage</h3><p>{claim.direct} direct England · {claim.indirect} indirect or transferable sources</p></div></div><h3>Transferability</h3><p>{claim.transfer}</p><h3>Key sources</h3><ul>{claim.sources.map(source => <li><a href={source.url} target="_blank" rel="noreferrer">{source.name}</a> <span>— {source.kind}</span></li>)}</ul></div></details>)}
      </div>
    </section>

    <section id="implementation" class="section-block" aria-labelledby="implementation-title">
      <div class="section-heading"><div><span class="eyebrow">From evidence to delivery</span><h2 id="implementation-title">A transition designed for learning and public value</h2><p>The evidence favours function-by-function staging with common safeguards over a uniform transfer model.</p></div></div>
      <ol class="dependency-map">
        <li><span>1</span><div><strong>Define the function and outcome</strong><p>Separate the intended public outcome from the preferred machinery.</p></div></li>
        <li><span>2</span><div><strong>Choose the effective geography</strong><p>Test local information, scale economies, spillovers and market integrity.</p></div></li>
        <li><span>3</span><div><strong>Align powers, finance, staff and data</strong><p>Move the components needed for a coherent causal pathway.</p></div></li>
        <li><span>4</span><div><strong>Build capability and scrutiny</strong><p>Treat local and central capability as investable infrastructure.</p></div></li>
        <li><span>5</span><div><strong>Stage transition with safeguards</strong><p>Use equalisation, floors, risk-sharing and transparent responsibilities.</p></div></li>
        <li><span>6</span><div><strong>Evaluate outcomes, distribution and cost</strong><p>Track additionality, transition burden, spillovers and who benefits.</p></div></li>
        <li><span>7</span><div><strong>Scale, adapt, pause or remediate</strong><p>Use pre-agreed evidence thresholds and support routes.</p></div></li>
      </ol>
    </section>

    <section id="downloads" class="section-block downloads" aria-labelledby="downloads-title">
      <div class="section-heading"><div><span class="eyebrow">Open research materials</span><h2 id="downloads-title">Download the full assessment</h2><p>The evidence table separates quality from directness and records transferability and caveats.</p></div></div>
      <div class="download-grid">
        <a href={`${base}downloads/rewiring-the-state-full-rea-bundle.zip`} download><strong>Complete research bundle</strong><span>REA, evidence table, screening log and visual specification · ZIP</span></a>
        <a href={`${base}downloads/rewiring-the-state-full-rea.md`} download><strong>Full rapid evidence assessment</strong><span>Protocol, findings, options, gaps and verified bibliography · Markdown</span></a>
        <a href={`${base}downloads/rewiring-the-state-evidence-table.csv`} download><strong>Evidence table</strong><span>39 included sources with appraisal and transferability · CSV</span></a>
        <a href={`${base}downloads/rewiring-the-state-search-screening-log.csv`} download><strong>Search and screening log</strong><span>58 logged records and decisions · CSV</span></a>
        <a href={`${base}downloads/rewiring-the-state-visualisation-spec.md`} download><strong>Visualisation specification</strong><span>Three-layer evidence architecture and acceptance tests · Markdown</span></a>
        <a href={`${base}downloads/rewiring-the-state-cabinet-statement.pdf`} download><strong>Primary document assessed</strong><span>Rewiring the State: Cabinet Statement · PDF</span></a>
      </div>
    </section>

    <section id="method" class="section-block method" aria-labelledby="method-title">
      <div class="section-heading"><div><span class="eyebrow">Method and limits</span><h2 id="method-title">How the assessment was produced</h2></div></div>
      <details class="card"><summary>Question, scope and evidence tiers</summary><div><p><strong>Question:</strong> To what extent, and under what conditions, does existing evidence support or challenge the principal causal claims in the Cabinet statement—particularly that transferring powers, resources and fiscal responsibility closer to place will improve growth, service integration, prevention, accountability and public value?</p><p>The assessment is independent and cross-government. Evidence is separated into direct England, wider UK, comparable international and broader global mechanism tiers.</p></div></details>
      <details class="card"><summary>Search, screening and appraisal</summary><div><p>Searches on 9 August 2026 covered academic indexes and primary repositories, PubMed/PMC, OECD, World Bank, UK government, the National Audit Office, Institute for Fiscal Studies and What Works sources. Of 58 logged records, 39 were included.</p><p>Each source was appraised for design, comparator, identification, outcome validity, reporting, relevance and transferability. Quality and directness were rated separately.</p></div></details>
      <details class="card"><summary>Rapid-review limitations</summary><div><p>This was a rapid assessment rather than an exhaustive systematic review. Citation chasing was selective, no unpublished evidence call was conducted, and bundled non-random reforms remain difficult to attribute. Confidence was reduced for indirectness, inconsistency, short follow-up and weak measures.</p></div></details>
    </section>

    <script id="reaData" type="application/json" set:html={JSON.stringify(payload)}></script>
  </div>

  <script>
    const raw = document.querySelector('#reaData');
    const data = JSON.parse(raw?.textContent || '{"claims":[],"departments":{},"portfolios":{}}');
    const byId = new Map(data.claims.map((claim) => [claim.id, claim]));
    const buttons = [...document.querySelectorAll('.claim-node')];
    const fields = {
      theme: document.querySelector('#themeFilter'), portfolio: document.querySelector('#portfolioFilter'),
      department: document.querySelector('#departmentFilter'), balance: document.querySelector('#balanceFilter'),
      confidence: document.querySelector('#confidenceFilter'), search: document.querySelector('#searchFilter'),
      overlap: document.querySelector('#overlapFilter')
    };

    const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[character]));
    const listHtml = (items) => items.map(item => `<li>${escapeHtml(item)}</li>`).join('');

    function selectClaim(id, moveFocus = false) {
      const claim = byId.get(id); if (!claim) return;
      buttons.forEach(button => { const selected = button.dataset.id === id; button.classList.toggle('selected', selected); button.setAttribute('aria-pressed', String(selected)); });
      const balance = document.querySelector('#selectedBalance'); balance.textContent = `${claim.judgement} · ${claim.confidence} confidence`; balance.className = `status-chip balance-${claim.balance}`;
      document.querySelector('#selectedTitle').textContent = claim.proposition;
      document.querySelector('#selectedConclusion').textContent = claim.conclusion;
      document.querySelector('#directCount').textContent = claim.direct;
      document.querySelector('#indirectCount').textContent = claim.indirect;
      document.querySelector('#confidenceValue').textContent = claim.confidence;
      document.querySelector('#pathClaim').textContent = claim.proposition;
      document.querySelector('#pathMechanism').textContent = claim.mechanism;
      document.querySelector('#pathConditions').innerHTML = listHtml(claim.conditions);
      document.querySelector('#pathOutcomes').innerHTML = listHtml(claim.outcomes);
      document.querySelector('#transferNote').textContent = claim.transfer;
      document.querySelector('#sourceList').innerHTML = claim.sources.map(source => `<article><a href="${escapeHtml(source.url)}" target="_blank" rel="noreferrer"><strong>${escapeHtml(source.name)} ↗</strong></a><span>${escapeHtml(source.kind)}</span></article>`).join('');
      document.querySelector('#departmentList').innerHTML = claim.departments.map(id => `<span>${escapeHtml(data.departments[id])}</span>`).join('');
      document.querySelector('#portfolioList').innerHTML = claim.portfolios.map(id => `<span>${escapeHtml(data.portfolios[id])}</span>`).join('');
      if (moveFocus && window.matchMedia('(max-width: 900px)').matches) { const card = document.querySelector('#selectedCard'); card.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start'}); card.focus({preventScroll:true}); }
    }

    function readState() {
      return { theme: fields.theme.value, portfolio: fields.portfolio.value, department: fields.department.value, balance: fields.balance.value, confidence: fields.confidence.value, search: fields.search.value.trim().toLowerCase(), overlap: fields.overlap.checked };
    }

    function syncUrl(state) {
      const params = new URLSearchParams();
      Object.entries(state).forEach(([key,value]) => { if (value && value !== 'all' && value !== false) params.set(key, String(value)); });
      history.replaceState({}, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
    }

    function applyFilters(updateUrl = true) {
      const state = readState(); let visible = 0;
      buttons.forEach(button => {
        const portfolios = button.dataset.portfolios.split(','); const departments = button.dataset.departments.split(',');
        const show = (state.theme === 'all' || button.dataset.theme === state.theme) &&
          (state.portfolio === 'all' || portfolios.includes(state.portfolio)) &&
          (state.department === 'all' || departments.includes(state.department)) &&
          (state.balance === 'all' || button.dataset.balance === state.balance) &&
          (state.confidence === 'all' || button.dataset.confidence === state.confidence) &&
          (!state.search || button.dataset.search.includes(state.search)) && (!state.overlap || departments.length > 1);
        button.hidden = !show; if (show) visible += 1;
      });
      document.querySelector('#resultCount').textContent = `${visible} of ${buttons.length} assessed claims shown.`;
      document.querySelector('#noResults').hidden = visible !== 0;
      const chips = [];
      if (state.theme !== 'all') chips.push(state.theme);
      if (state.portfolio !== 'all') chips.push(data.portfolios[state.portfolio]);
      if (state.department !== 'all') chips.push(data.departments[state.department]);
      if (state.balance !== 'all') chips.push(`Balance: ${state.balance}`);
      if (state.confidence !== 'all') chips.push(`Confidence: ${state.confidence}`);
      if (state.search) chips.push(`Search: ${state.search}`);
      if (state.overlap) chips.push('Cross-department only');
      document.querySelector('#filterChips').innerHTML = chips.map(chip => `<span>${escapeHtml(chip)}</span>`).join('');
      document.querySelector('#filterSummary').textContent = `${chips.length} applied`;
      const selected = buttons.find(button => button.getAttribute('aria-pressed') === 'true');
      if (selected?.hidden) { const firstVisible = buttons.find(button => !button.hidden); if (firstVisible) selectClaim(firstVisible.dataset.id); }
      if (updateUrl) syncUrl(state);
    }

    function clearFilters() {
      fields.theme.value = fields.portfolio.value = fields.department.value = fields.balance.value = fields.confidence.value = 'all';
      fields.search.value = ''; fields.overlap.checked = false; applyFilters();
    }

    function loadUrl() {
      const params = new URLSearchParams(location.search);
      ['theme','portfolio','department','balance','confidence'].forEach(key => { const value = params.get(key); if (value && [...fields[key].options].some(option => option.value === value)) fields[key].value = value; });
      fields.search.value = params.get('search') || ''; fields.overlap.checked = params.get('overlap') === 'true'; applyFilters(false);
    }

    buttons.forEach(button => button.addEventListener('click', () => selectClaim(button.dataset.id, true)));
    Object.values(fields).forEach(field => field.addEventListener(field.type === 'search' ? 'input' : 'change', () => applyFilters()));
    document.querySelector('#clearFilters').addEventListener('click', clearFilters);
    document.querySelector('#noResults button').addEventListener('click', clearFilters);
    document.querySelector('#resetSelection').addEventListener('click', () => { const preferred = buttons.find(button => button.dataset.id === 'capability' && !button.hidden) || buttons.find(button => !button.hidden); if (preferred) selectClaim(preferred.dataset.id); });
    loadUrl(); const initial = buttons.find(button => button.dataset.id === 'capability' && !button.hidden) || buttons.find(button => !button.hidden); if (initial) selectClaim(initial.dataset.id);
  </script>

